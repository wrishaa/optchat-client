<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>$(OPTCHAT_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>OptChat</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIconName</key><string>AppIcon</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UILaunchScreen</key><dict><key>UIColorName</key><string></string></dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array><dict>
				<key>UISceneConfigurationName</key><string>Default Configuration</string>
				<key>UISceneDelegateClassName</key><string>GPUIIosSceneDelegate</string>
			</dict></array>
		</dict>
	</dict>
	<!-- iPhone: portrait only. iPad: landscape preferred; the layout follows the window's shape (PLAN.md §2). -->
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>UIRequiresFullScreen</key><true/>
	<key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
	<key>CADisableMinimumFrameDurationOnPhone</key><true/>
	<!-- only the system's TLS (Security.framework via native-tls): exempt from export compliance documentation -->
	<key>NSCameraUsageDescription</key>
	<string>OptChat uses the camera only to scan an engine token's QR code.</string>
	<key>NSMicrophoneUsageDescription</key><string>OptChat records your voice while you dictate a message.</string>
	<!-- lan-first: find the engine's lan front on the local network (bonjour) and connect to it directly -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>OptChat looks for your engine on this network to connect to it directly instead of through the internet.</string>
	<key>NSBonjourServices</key>
	<array><string>_optchat-lan._tcp</string></array>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
</dict>
</plist>
