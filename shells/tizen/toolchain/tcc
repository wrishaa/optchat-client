#!/bin/sh
# tizen arm (soft-float abi, armv7) cross cc/linker via tizen studio's llvm-10 + rootstrap 9.0 + gcc 14.2 crt/libgcc
T=${TIZEN_STUDIO:-$HOME/tizen-studio}
R=$T/platforms/tizen-9.0/tizen/rootstraps/tizen-9.0-device.core
G=$T/tools/arm-linux-gnueabi-gcc-14.2
exec $T/tools/llvm-10/bin/clang --target=arm-tizen-linux-gnueabi -march=armv7-a -mfloat-abi=softfp -mfpu=neon --sysroot=$R --gcc-toolchain=$G -B$G/lib/gcc/arm-tizen-linux-gnueabi/14.2.0 -L$G/lib/gcc/arm-tizen-linux-gnueabi/14.2.0 -L$G/arm-tizen-linux-gnueabi/lib -fuse-ld=lld -Wl,--allow-shlib-undefined "$@"
