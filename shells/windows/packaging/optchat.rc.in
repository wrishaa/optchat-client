#include <windows.h>

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @NUMERIC_VERSION@
PRODUCTVERSION @NUMERIC_VERSION@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OptChat\0"
            VALUE "ProductName", "OptChat\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "ProductVersion", "@VERSION@\0"
            VALUE "OriginalFilename", "optchat.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
