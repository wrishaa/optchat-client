FROM docker.io/library/ubuntu:24.04
ARG RUST_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang cmake pkg-config git curl ca-certificates python3 \
    libasound2-dev libfontconfig-dev libssl-dev libwayland-dev libx11-xcb-dev \
    libxkbcommon-x11-dev libvulkan1 dpkg-dev desktop-file-utils binutils lintian \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl --fail --show-error --location https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup-init.sh
ENV PATH=/opt/cargo/bin:$PATH
WORKDIR /workspace
