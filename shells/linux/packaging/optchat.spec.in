# Cargo is compiled natively by package_rpm.py before this payload is assembled.
%global debug_package %{nil}

Name: optchat
Version: @VERSION@
Release: @REVISION@%{?dist}
Summary: Native client for task and chat engines
License: @LICENSE@
URL: https://github.com/fabihatasneem/optchat-client
Packager: @MAINTAINER@
Source0: payload.tar.gz
ExclusiveArch: x86_64 aarch64

# ELF dependencies are generated by RPM. These cover dlopen and desktop services.
Requires: fontconfig
Requires: libwayland-client.so.0()(64bit)
Requires: vulkan-loader
Requires: libEGL.so.1()(64bit)
Requires: libGLESv2.so.2()(64bit)
Requires: ca-certificates
Requires: xdg-utils
Requires: xdg-desktop-portal
Requires: desktop-file-utils
Requires: hicolor-icon-theme
Recommends: mesa-vulkan-drivers
Recommends: gnome-keyring

%description
Native Rust/GPUI desktop client with chats, tasks and dictation.
Connect to your own OptChat engine using a scoped client token.

%prep
%setup -q -c -n optchat-payload

%build
# The baseline-native Cargo build is performed by the packaging helper.

%install
mkdir -p %{buildroot}/usr
cp -a usr/. %{buildroot}/usr/

%files
%defattr(-,root,root,-)
%{_bindir}/optchat
%dir %{_libexecdir}/optchat
%{_libexecdir}/optchat/optchat
%{_datadir}/applications/com.reframe.optchat.gpui.desktop
%{_datadir}/icons/hicolor/512x512/apps/com.reframe.optchat.gpui.png
%{_mandir}/man1/optchat.1*
%doc %{_docdir}/optchat
%license %{_datadir}/licenses/optchat

%changelog
* @CHANGELOG_DATE@ @MAINTAINER@ - @VERSION@-@REVISION@
- Build the native OptChat Linux client package.
