diff --git a/src/android/editor.rs b/src/android/editor.rs
new file mode 100644
index 0000000..a231c3c
--- /dev/null
+++ b/src/android/editor.rs
@@ -0,0 +1,120 @@
+//! IME snapshots are queued on Java's UI thread and applied on GPUI's event thread.
+//! No GPUI entity or window is accessed from a JNI callback.
+use gpui::{FocusId, PlatformInputHandler};
+use std::{cell::RefCell, rc::{Rc, Weak}, sync::{Mutex, atomic::{AtomicBool, Ordering}}};
+use jni::objects::JValue;
+
+type Handler = Rc<RefCell<Option<PlatformInputHandler>>>;
+thread_local! {
+    static HANDLER: RefCell<Weak<RefCell<Option<PlatformInputHandler>>>> = RefCell::new(Weak::new());
+    static SESSION: RefCell<Session> = RefCell::new(Session::default());
+}
+#[derive(Default)]
+struct Session {
+    focus: Option<FocusId>, id: i64, revision: i64,
+    sent: Option<(String, usize, usize)>,
+}
+pub struct Snapshot {
+    pub session: i64, pub revision: i64, pub text: String,
+    pub start: usize, pub end: usize, pub composing: Option<std::ops::Range<usize>>,
+}
+static PENDING: Mutex<Option<Snapshot>> = Mutex::new(None);
+static INSETS: Mutex<[i32; 4]> = Mutex::new([0; 4]);
+pub static INSETS_DIRTY: AtomicBool = AtomicBool::new(false);
+static BACK_PENDING: AtomicBool = AtomicBool::new(false);
+pub fn request_back() { BACK_PENDING.store(true, Ordering::Release); }
+
+pub fn register(handler: &Handler) { HANDLER.with(|slot| *slot.borrow_mut() = Rc::downgrade(handler)); }
+pub fn enqueue(snapshot: Snapshot) {
+    if snapshot.text.len() <= 1_048_576 { *PENDING.lock().unwrap() = Some(snapshot); }
+}
+pub fn set_insets(value: [i32; 4]) {
+    let mut current = INSETS.lock().unwrap();
+    if *current != value { *current = value; INSETS_DIRTY.store(true, Ordering::Release); }
+}
+pub fn insets() -> [i32; 4] { *INSETS.lock().unwrap() }
+
+pub fn call_void(method: &jni::strings::JNIStr) {
+    let _ = super::jni::with_env(|env| {
+        let activity = super::jni::activity(env)?;
+        env.call_method(&activity, method, jni::jni_sig!("()V"), &[]).map_err(|e| e.to_string())?;
+        Ok(())
+    });
+}
+
+pub fn string_call(method: &jni::strings::JNIStr, text: &str) {
+    let _ = super::jni::with_env(|env| {
+        let activity = super::jni::activity(env)?;
+        let value = env.new_string(text).map_err(|e| e.to_string())?;
+        env.call_method(&activity, method, jni::jni_sig!("(Ljava/lang/String;)V"), &[JValue::Object(value.as_ref())])
+            .map_err(|e| e.to_string())?;
+        Ok(())
+    });
+}
+
+/// Called between GPUI updates, so input handler methods may safely update their window.
+pub fn process() {
+    if BACK_PENDING.swap(false, Ordering::AcqRel) {
+        if let Some(window) = super::jni::platform().and_then(|platform| platform.primary_window()) {
+            for action in [0, 1] {
+                window.handle_key_event(super::AndroidKeyEvent { key_code: 4, action, meta_state: 0, unicode_char: 0 });
+            }
+        }
+    }
+    let Some(slot) = HANDLER.with(|slot| slot.borrow().upgrade()) else { return };
+    let Some(mut handler) = slot.borrow_mut().take() else { return };
+    let focused = handler.query_accepts_focused_text_input();
+    SESSION.with(|state| {
+        let mut state = state.borrow_mut();
+        let focus = focused.then(|| handler.focus_id()).flatten();
+        if state.focus != focus {
+            state.focus = focus; state.id += 1; state.revision = 0; state.sent = None;
+        }
+        if !focused { return; }
+        if let Some(edit) = PENDING.lock().unwrap().take() {
+            if edit.session == state.id && edit.revision > state.revision {
+                let length = handler.text_length_utf16().unwrap_or(0);
+                let old = handler.text_for_range(0..length, &mut None).unwrap_or_default();
+                handler.unmark_text();
+                if old != edit.text {
+                    let (range, replacement) = changed_range(&old, &edit.text);
+                    handler.replace_text_in_range(Some(range), &replacement);
+                }
+                let length = edit.text.encode_utf16().count();
+                if let Some(range) = edit.composing.filter(|r| r.start < r.end && r.end <= length) {
+                    let text = String::from_utf16_lossy(&edit.text.encode_utf16().collect::<Vec<_>>()[range.clone()]);
+                    handler.replace_and_mark_text_in_range(Some(range), &text, None);
+                }
+                handler.set_selected_text_range(edit.start.min(edit.end).min(length)..edit.start.max(edit.end).min(length));
+                state.revision = edit.revision;
+            }
+        }
+        let length = handler.text_length_utf16().unwrap_or(0);
+        let text = handler.text_for_range(0..length, &mut None).unwrap_or_default();
+        let Some(selection) = handler.selected_text_range(false) else { return };
+        let start = selection.range.start; let end = selection.range.end;
+        let snapshot = (text, start, end);
+        if state.sent.as_ref() == Some(&snapshot) { return; }
+        let _ = super::jni::with_env(|env| {
+            let activity = super::jni::activity(env)?;
+            let text = env.new_string(&snapshot.0).map_err(|e| e.to_string())?;
+            env.call_method(&activity, jni::jni_str!("gpuiUpdateEditor"), jni::jni_sig!("(JJLjava/lang/String;II)V"), &[
+                JValue::Long(state.id), JValue::Long(state.revision), JValue::Object(text.as_ref()),
+                JValue::Int(start as i32), JValue::Int(end as i32),
+            ]).map_err(|e| e.to_string())?;
+            Ok(())
+        });
+        state.sent = Some(snapshot);
+    });
+    // Repainting while handling a snapshot can register a newer adapter.
+    if slot.borrow().is_none() { *slot.borrow_mut() = Some(handler); }
+}
+
+fn changed_range(old: &str, new: &str) -> (std::ops::Range<usize>, String) {
+    let old: Vec<char> = old.chars().collect(); let new: Vec<char> = new.chars().collect();
+    let prefix = old.iter().zip(&new).take_while(|(a,b)| a == b).count();
+    let suffix = old[prefix..].iter().rev().zip(new[prefix..].iter().rev()).take_while(|(a,b)| a == b).count();
+    let start = old[..prefix].iter().map(|c| c.len_utf16()).sum();
+    let end = old[..old.len()-suffix].iter().map(|c| c.len_utf16()).sum();
+    (start..end, new[prefix..new.len()-suffix].iter().collect())
+}
