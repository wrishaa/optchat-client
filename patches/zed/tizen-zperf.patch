+/// dev perf hook (optchat tizen): a renderer may install a sink for draw phase timings (ms). Unset = no cost
+/// beyond a OnceLock read per phase.
+pub mod perf_hook {
+    pub static HOOK: std::sync::OnceLock<fn(&'static str, f32)> = std::sync::OnceLock::new();
+    #[inline]
+    pub fn start() -> Option<std::time::Instant> {
+        HOOK.get().map(|_| std::time::Instant::now())
+    }
+    /// per-frame accumulators (microseconds), flushed by `flush` at the end of Window::draw
+    pub static LAYOUT_US: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    pub static LAYOUT_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    pub fn add_layout(t: Option<std::time::Instant>) {
+        if let (Some(t), Some(f)) = (t, HOOK.get()) {
+            f("gLayoutCall", t.elapsed().as_secs_f32() * 1000.0);
+        }
+        if let Some(t) = t {
+            LAYOUT_US.fetch_add(t.elapsed().as_micros() as u64, std::sync::atomic::Ordering::Relaxed);
+            LAYOUT_N.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+    pub static MEASURE_US: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    pub static MEASURE_N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    pub static NODES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    pub fn add_measure(t: Option<std::time::Instant>) {
+        if let Some(t) = t {
+            MEASURE_US.fetch_add(t.elapsed().as_micros() as u64, std::sync::atomic::Ordering::Relaxed);
+            MEASURE_N.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+    pub fn add_nodes(n: u64) {
+        NODES.fetch_add(n, std::sync::atomic::Ordering::Relaxed);
+    }
+    pub fn flush() {
+        if let Some(f) = HOOK.get() {
+            f("gMeasure", MEASURE_US.swap(0, std::sync::atomic::Ordering::Relaxed) as f32 / 1000.0);
+            f("gMeasureCalls", MEASURE_N.swap(0, std::sync::atomic::Ordering::Relaxed) as f32);
+            f("gLayoutNodes", NODES.swap(0, std::sync::atomic::Ordering::Relaxed) as f32);
+            f("gComputeLayout", LAYOUT_US.swap(0, std::sync::atomic::Ordering::Relaxed) as f32 / 1000.0);
+            f("gComputeLayoutCalls", LAYOUT_N.swap(0, std::sync::atomic::Ordering::Relaxed) as f32);
+        }
+    }
+    #[inline]
+    pub fn end(name: &'static str, t: Option<std::time::Instant>) {
+        if let (Some(f), Some(t)) = (HOOK.get(), t) {
+            f(name, t.elapsed().as_secs_f32() * 1000.0)
+        }
+    }
+}
+
