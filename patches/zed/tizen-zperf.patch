diff --git a/crates/gpui_wgpu/src/perf.rs b/crates/gpui_wgpu/src/perf.rs
new file mode 100644
index 0000000..13d8018
--- /dev/null
+++ b/crates/gpui_wgpu/src/perf.rs
@@ -0,0 +1,236 @@
+//! dev-only frame / input counters (feature `perf-counters`, off by default; the tizen tv shell's `build.sh --perf`).
+//! Without the feature every hook is an empty inline fn, so callers (gpui_linux wayland, the renderer) need no cfg.
+//! Measures, on the ui thread:
+//! - `frame`: one platform frame tick (gpui layout + paint + our draw), wall ms
+//! - `draw`: the renderer's part of it (acquire + encode + submit + present), wall ms
+//! - `present gap`: ms between consecutive presents (fps and dropped frames while something animates / scrolls)
+//! - `input to present`: from a key event reaching the client to the first present after it
+//! - `first present`: since process start (cold start, /proc/self/stat starttime)
+//! `take()` returns the stats since the last call as json and resets them.
+
+#[cfg(feature = "perf-counters")]
+mod imp {
+    use parking_lot::Mutex;
+    use std::time::Instant;
+
+    #[derive(Default)]
+    struct St {
+        frame_t0: Option<Instant>,
+        frames: Vec<f32>,
+        draw_t0: Option<Instant>,
+        draws: Vec<f32>,
+        last_present: Option<Instant>,
+        gaps: Vec<f32>,
+        input_pending: Option<(Instant, String)>,
+        inputs: Vec<(String, f32)>,
+        key_lag: Vec<f32>,
+        first_present_ms: Option<f64>,
+        first_reported: bool,
+        skipped_draws: u32,
+        phases: Vec<(&'static str, Vec<f32>)>,
+    }
+    static ST: Mutex<Option<St>> = Mutex::new(None);
+    fn with<R>(f: impl FnOnce(&mut St) -> R) -> R {
+        let mut g = ST.lock();
+        f(g.get_or_insert_with(St::default))
+    }
+    fn ms(a: Instant, b: Instant) -> f32 {
+        (b - a).as_secs_f32() * 1000.0
+    }
+
+    /// a key reached the client (`what`: a label; `lag_ms`: compositor event time to now, if known)
+    pub fn mark_input(what: &str, lag_ms: Option<f32>) {
+        let now = Instant::now();
+        with(|s| {
+            if s.input_pending.is_none() {
+                s.input_pending = Some((now, what.to_string()));
+            }
+            if let Some(l) = lag_ms {
+                s.key_lag.push(l);
+            }
+        })
+    }
+    pub fn frame_begin() {
+        with(|s| s.frame_t0 = Some(Instant::now()))
+    }
+    /// a named sub-phase, ms since `t0` (renderer acquire / encode / present, ...)
+    pub fn phase(name: &'static str, t0: Instant) {
+        let d = ms(t0, Instant::now());
+        with(|s| match s.phases.iter_mut().find(|p| p.0 == name) {
+            Some(p) => p.1.push(d),
+            None => s.phases.push((name, vec![d])),
+        })
+    }
+    pub fn sample(name: &'static str, v: f32) {
+        with(|s| match s.phases.iter_mut().find(|p| p.0 == name) {
+            Some(p) => p.1.push(v),
+            None => s.phases.push((name, vec![v])),
+        });
+    }
+    pub static SKIP: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    pub fn skip(bit: u32) -> bool {
+        SKIP.load(std::sync::atomic::Ordering::Relaxed) & bit != 0
+    }
+    pub fn set_skip(m: u32) {
+        SKIP.store(m, std::sync::atomic::Ordering::Relaxed)
+    }
+    pub fn now() -> Option<Instant> {
+        Some(Instant::now())
+    }
+    pub fn frame_end() {
+        let now = Instant::now();
+        with(|s| {
+            if let Some(t) = s.frame_t0.take() {
+                s.frames.push(ms(t, now))
+            }
+        })
+    }
+    pub fn draw_begin() {
+        with(|s| s.draw_t0 = Some(Instant::now()))
+    }
+    /// `presented`: false when the draw bailed (lost surface, gpu error) before present
+    pub fn draw_end(presented: bool) {
+        let now = Instant::now();
+        with(|s| {
+            if let Some(t) = s.draw_t0.take() {
+                s.draws.push(ms(t, now))
+            }
+            if !presented {
+                s.skipped_draws += 1;
+                return;
+            }
+            if let Some(p) = s.last_present.replace(now) {
+                s.gaps.push(ms(p, now))
+            }
+            if let Some((t, what)) = s.input_pending.take() {
+                s.inputs.push((what, ms(t, now)))
+            }
+            if s.first_present_ms.is_none() {
+                s.first_present_ms = since_process_start_ms();
+                // the mac log server stamps this line: cold start = its time - the launch command's (the
+                // process start time is useless on tizen: launchpad pre-forks candidate processes)
+                log::info!("perf: first present");
+            }
+        })
+    }
+
+    /// ms since this process started (linux /proc), for cold start
+    fn since_process_start_ms() -> Option<f64> {
+        let stat = std::fs::read_to_string("/proc/self/stat").ok()?;
+        let rest = &stat[stat.rfind(')')? + 2..];
+        let start_ticks: f64 = rest.split(' ').nth(19)?.parse().ok()?;
+        unsafe extern "C" {
+            fn sysconf(name: i32) -> isize;
+        }
+        let hz = unsafe { sysconf(2) } as f64; // _SC_CLK_TCK
+        let hz = if hz > 0.0 { hz } else { 100.0 };
+        let up: f64 = std::fs::read_to_string("/proc/uptime").ok()?.split(' ').next()?.parse().ok()?;
+        log::info!("perf: cold start calc uptime {up} start_ticks {start_ticks} hz {hz}");
+        Some((up - start_ticks / hz) * 1000.0)
+    }
+
+    fn summary(v: &mut Vec<f32>) -> String {
+        if v.is_empty() {
+            return "null".into();
+        }
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let p = |q: f32| v[((v.len() - 1) as f32 * q).round() as usize];
+        let mean = v.iter().sum::<f32>() / v.len() as f32;
+        format!(
+            "{{\"n\":{},\"mean\":{:.2},\"p50\":{:.2},\"p90\":{:.2},\"p99\":{:.2},\"max\":{:.2}}}",
+            v.len(),
+            mean,
+            p(0.5),
+            p(0.9),
+            p(0.99),
+            v[v.len() - 1]
+        )
+    }
+
+    /// stats since the last take, as json; resets them
+    pub fn take() -> Option<String> {
+        with(|s| {
+            let over_17 = s.gaps.iter().filter(|g| **g > 17.5).count();
+            let dropped: f32 = s.gaps.iter().map(|g| ((g / 16.67).round() - 1.0).max(0.0)).sum();
+            let inputs: Vec<String> = s.inputs.iter().map(|(w, m)| format!("[\"{}\",{:.1}]", w.replace('"', ""), m)).collect();
+            let mut ilat: Vec<f32> = s.inputs.iter().map(|x| x.1).collect();
+            let first = if s.first_reported { None } else { s.first_present_ms };
+            if first.is_some() {
+                s.first_reported = true;
+            }
+            let out = format!(
+                "{{\"frame\":{},\"draw\":{},\"gap\":{},\"gapsOver17\":{},\"droppedEst\":{},\"inputToPresent\":{},\"inputs\":[{}],\"keyLag\":{},\"skippedDraws\":{},\"firstPresentMs\":{},\"phases\":{{{}}}}}",
+                summary(&mut s.frames),
+                summary(&mut s.draws),
+                summary(&mut s.gaps),
+                over_17,
+                dropped,
+                summary(&mut ilat),
+                inputs.join(","),
+                summary(&mut s.key_lag),
+                s.skipped_draws,
+                first.map(|f| format!("{f:.0}")).unwrap_or("null".into()),
+                s.phases.iter_mut().map(|(n, v)| format!("\"{n}\":{}", summary(v))).collect::<Vec<_>>().join(",")
+            );
+            s.phases.clear();
+            s.frames.clear();
+            s.draws.clear();
+            s.gaps.clear();
+            s.inputs.clear();
+            s.key_lag.clear();
+            s.skipped_draws = 0;
+            Some(out)
+        })
+    }
+}
+
+#[cfg(not(feature = "perf-counters"))]
+mod imp {
+    #[inline(always)]
+    pub fn mark_input(_: &str, _: Option<f32>) {}
+    #[inline(always)]
+    pub fn frame_begin() {}
+    #[inline(always)]
+    pub fn frame_end() {}
+    #[inline(always)]
+    pub fn draw_begin() {}
+    #[inline(always)]
+    pub fn draw_end(_: bool) {}
+    #[inline(always)]
+    pub fn phase(_: &'static str, _: ()) {}
+    #[inline(always)]
+    pub fn sample(_: &'static str, _: f32) {}
+    #[inline(always)]
+    pub fn skip(_: u32) -> bool {
+        false
+    }
+    pub fn set_skip(_: u32) {}
+    pub fn now() -> Option<()> {
+        None
+    }
+    #[inline(always)]
+    pub fn take() -> Option<String> {
+        None
+    }
+}
+
+pub use imp::*;
+
+/// true when the counters are compiled in
+pub const ENABLED: bool = cfg!(feature = "perf-counters");
+
+/// startup timing: logs `perf lap <name> <ms>` when dropped
+#[cfg(feature = "perf-counters")]
+pub struct Lap(&'static str, String, std::time::Instant);
+#[cfg(feature = "perf-counters")]
+impl Lap {
+    pub fn new(name: &str) -> Self {
+        Lap("", name.to_string(), std::time::Instant::now())
+    }
+}
+#[cfg(feature = "perf-counters")]
+impl Drop for Lap {
+    fn drop(&mut self) {
+        log::info!("perf lap {} {:.1}ms", self.1, self.2.elapsed().as_secs_f64() * 1000.0);
+    }
+}
diff --git a/crates/gpui_wgpu/src/quad_cull.rs b/crates/gpui_wgpu/src/quad_cull.rs
new file mode 100644
index 0000000..ab3c71c
--- /dev/null
+++ b/crates/gpui_wgpu/src/quad_cull.rs
@@ -0,0 +1,170 @@
+//! Overdraw culling for opaque nested backgrounds (optchat tizen perf).
+//!
+//! UIs often paint the same opaque background several times: window, pane, list, composer. On weak tilers (the
+//! Samsung TV's Mali-G31) every covered pixel still runs the quad fragment shader, and those redundant layers were most
+//! of the frame's GPU time. A quad Q is culled (drawn with zero size) when an earlier quad P:
+//!   * is an opaque solid, unrounded, borderless quad of exactly Q's colour (Q is solid opaque borderless too), and
+//!   * fully contains Q's visible area (bounds clipped to the content mask), and
+//!   * nothing else in the scene with a draw order in [P.order, Q.order] touches Q's visible area.
+//! Then Q would repaint pixels with the colour they already have, so skipping it leaves the frame identical.
+
+use gpui::{Bounds, Quad, Scene, ScaledPixels};
+
+#[derive(Clone, Copy)]
+struct R {
+    x0: f32,
+    y0: f32,
+    x1: f32,
+    y1: f32,
+}
+
+impl R {
+    fn of(b: &Bounds<ScaledPixels>) -> R {
+        R { x0: b.origin.x.0, y0: b.origin.y.0, x1: b.origin.x.0 + b.size.width.0, y1: b.origin.y.0 + b.size.height.0 }
+    }
+    fn clip(self, o: R) -> R {
+        R { x0: self.x0.max(o.x0), y0: self.y0.max(o.y0), x1: self.x1.min(o.x1), y1: self.y1.min(o.y1) }
+    }
+    fn empty(&self) -> bool {
+        self.x1 <= self.x0 || self.y1 <= self.y0
+    }
+    fn contains(&self, o: &R) -> bool {
+        self.x0 <= o.x0 && self.y0 <= o.y0 && self.x1 >= o.x1 && self.y1 >= o.y1
+    }
+    fn hits(&self, o: &R) -> bool {
+        self.x0 < o.x1 && o.x0 < self.x1 && self.y0 < o.y1 && o.y0 < self.y1
+    }
+    fn grow(self, d: f32) -> R {
+        R { x0: self.x0 - d, y0: self.y0 - d, x1: self.x1 + d, y1: self.y1 + d }
+    }
+}
+
+fn visible(q: &Quad) -> R {
+    R::of(&q.bounds).clip(R::of(&q.content_mask.bounds))
+}
+
+fn plain(q: &Quad) -> bool {
+    let b = &q.border_widths;
+    b.top.0 == 0.0 && b.right.0 == 0.0 && b.bottom.0 == 0.0 && b.left.0 == 0.0
+}
+
+fn square(q: &Quad) -> bool {
+    let r = &q.corner_radii;
+    r.top_left.0 == 0.0 && r.top_right.0 == 0.0 && r.bottom_right.0 == 0.0 && r.bottom_left.0 == 0.0
+}
+
+fn opaque_solid(q: &Quad) -> Option<gpui::Hsla> {
+    q.background.as_solid().filter(|c| c.a >= 1.0)
+}
+
+/// does any primitive other than quads `skip_a`/`skip_b` with order in [lo, hi] touch `r`?
+fn blocked(scene: &Scene, lo: u32, hi: u32, r: &R, skip_a: usize, skip_b: usize) -> bool {
+    fn any<T>(v: &[T], lo: u32, hi: u32, order: impl Fn(&T) -> u32, hit: impl Fn(usize, &T) -> bool) -> bool {
+        let start = v.partition_point(|x| order(x) < lo);
+        v[start..].iter().enumerate().take_while(|(_, x)| order(x) <= hi).any(|(i, x)| hit(start + i, x))
+    }
+    any(&scene.quads, lo, hi, |q| q.order, |i, q| i != skip_a && i != skip_b && visible(q).hits(r))
+        || any(&scene.shadows, lo, hi, |s| s.order, |_, s| {
+            // a shadow's blur reaches past its bounds: be generous
+            R::of(&s.bounds).grow(s.blur_radius.0 * 3.0 + 2.0).clip(R::of(&s.content_mask.bounds)).hits(r)
+        })
+        || any(&scene.paths, lo, hi, |p| p.order, |_, p| R::of(&p.bounds).hits(r))
+        || any(&scene.underlines, lo, hi, |u| u.order, |_, u| R::of(&u.bounds).hits(r))
+        || any(&scene.monochrome_sprites, lo, hi, |s| s.order, |_, s| R::of(&s.bounds).hits(r))
+        || any(&scene.subpixel_sprites, lo, hi, |s| s.order, |_, s| R::of(&s.bounds).hits(r))
+        || any(&scene.polychrome_sprites, lo, hi, |s| s.order, |_, s| R::of(&s.bounds).hits(r))
+        || any(&scene.surfaces, lo, hi, |s| s.order, |_, s| R::of(&s.bounds).hits(r))
+}
+
+thread_local!(static BASE: std::cell::Cell<Option<usize>> = const { std::cell::Cell::new(None) });
+
+/// When the scene's first primitive is an opaque square borderless quad covering the whole target, return its
+/// colour: the render pass clears to it and `cull` drops the quad (a clear is ~free on tilers, a full-screen fill
+/// is not). Remembered for the following `cull` call of the same frame.
+pub fn base_clear(scene: &Scene, width: f32, height: f32) -> Option<gpui::Rgba> {
+    BASE.with(|b| b.set(None));
+    if crate::perf::skip(128) {
+        return None;
+    }
+    let q = scene.quads.first()?;
+    let c = opaque_solid(q).filter(|_| square(q) && plain(q))?;
+    if !visible(q).contains(&R { x0: 0.0, y0: 0.0, x1: width, y1: height }) {
+        return None;
+    }
+    // nothing may be drawn before it (ties count as before: batch order within an order is by kind)
+    let before = |o: Option<u32>| o.is_some_and(|o| o <= q.order);
+    if scene.quads.get(1).is_some_and(|x| x.order == q.order)
+        || before(scene.shadows.first().map(|x| x.order))
+        || before(scene.paths.first().map(|x| x.order))
+        || before(scene.underlines.first().map(|x| x.order))
+        || before(scene.monochrome_sprites.first().map(|x| x.order))
+        || before(scene.subpixel_sprites.first().map(|x| x.order))
+        || before(scene.polychrome_sprites.first().map(|x| x.order))
+        || before(scene.surfaces.first().map(|x| x.order))
+    {
+        return None;
+    }
+    BASE.with(|b| b.set(Some(0)));
+    Some(gpui::Rgba::from(c))
+}
+
+/// the scene's quads with redundant ones collapsed to zero size, or None when nothing could be culled
+pub fn cull(scene: &Scene) -> Option<Vec<Quad>> {
+    if crate::perf::skip(128) {
+        return None;
+    }
+    let quads = &scene.quads;
+    let base = BASE.with(|b| b.take());
+    // candidate covers: opaque, square, borderless quads (usually a handful of pane backgrounds)
+    let covers: Vec<usize> = (0..quads.len()).filter(|&i| square(&quads[i]) && plain(&quads[i]) && opaque_solid(&quads[i]).is_some()).collect();
+    let mut out: Option<Vec<Quad>> = None;
+    if let Some(i) = base {
+        out.get_or_insert_with(|| quads.clone())[i].bounds.size = gpui::Size::default();
+    }
+    if covers.len() < 2 {
+        return out;
+    }
+    for &j in covers.iter().skip(1) {
+        let q = &quads[j];
+        let color = opaque_solid(q);
+        let vq = visible(q);
+        if vq.empty() {
+            continue;
+        }
+        // the nearest earlier cover of the same colour that contains q
+        let Some(&i) = covers.iter().rev().filter(|&&i| i < j).find(|&&i| {
+            let p = &quads[i];
+            p.order < q.order && opaque_solid(p) == color && visible(p).contains(&vq)
+        }) else {
+            continue;
+        };
+        if blocked(scene, quads[i].order, q.order, &vq, i, j) {
+            continue;
+        }
+        let v = out.get_or_insert_with(|| quads.clone());
+        v[j].bounds.size = gpui::Size::default();
+        crate::perf::sample("culledArea", (vq.x1 - vq.x0) * (vq.y1 - vq.y0));
+    }
+    out
+}
+
+/// quads fs_quad_simple draws exactly like fs_quad: solid background, square corners, no border
+/// solid background and solid border, any radii / border widths: fs_quad_lean (no gradient, no dashes)
+pub fn lean(q: &Quad) -> bool {
+    q.background.as_solid().is_some() && matches!(q.border_style, gpui::BorderStyle::Solid)
+}
+
+/// 0 simple, 1 lean, 2 full fs_quad
+pub fn kind(q: &Quad) -> u8 {
+    if simple(q) {
+        0
+    } else if lean(q) && !crate::perf::skip(2048) {
+        1
+    } else {
+        2
+    }
+}
+
+pub fn simple(q: &Quad) -> bool {
+    q.background.as_solid().is_some() && square(q) && plain(q)
+}
