diff --git a/crates/gpui_wgpu/src/damage.rs b/crates/gpui_wgpu/src/damage.rs
new file mode 100644
index 0000000..9b426e0
--- /dev/null
+++ b/crates/gpui_wgpu/src/damage.rs
@@ -0,0 +1,148 @@
+//! optchat (tizen tv): damage-limited redraw.
+//!
+//! On the GLES/EGL backend the surface texture is one persistent renderbuffer (blitted to the window at
+//! present), so a frame only has to redraw the pixels whose primitives changed since the previous frame.
+//! The previous frame's primitives are kept as (hash, visible bounds) per kind; the damage is the union of
+//! the bounds of every primitive that differs at the same index (old and new), plus any length change. The
+//! whole scene is then drawn with a scissor at the damage rect over the loaded old pixels, which gives the
+//! same pixels as a full redraw inside the rect.
+//!
+//! Opt-in with GPUI_DAMAGE=1 (set by the tizen shell); never on swapchains that rotate textures.
+
+use gpui::{Bounds, ContentMask, ScaledPixels, Scene};
+
+#[derive(Default)]
+pub struct Digest {
+    kinds: [Vec<(u64, [f32; 4])>; 7],
+    size: (i32, i32),
+}
+
+thread_local!(pub static STATS: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) });
+
+pub fn enabled() -> bool {
+    use std::sync::OnceLock;
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("GPUI_DAMAGE").is_ok_and(|v| v == "1"))
+}
+
+fn h<T: Copy>(x: &T) -> u64 {
+    // repr(C) plain-data primitives (f32/u32 fields): hash the raw bytes
+    let b = unsafe { std::slice::from_raw_parts(x as *const T as *const u8, std::mem::size_of::<T>()) };
+    words(b)
+}
+
+fn words(b: &[u8]) -> u64 {
+    // fx-style word hash (cheap on armv7)
+    let mut s: u64 = 0;
+    let mut it = b.chunks_exact(4);
+    for w in &mut it {
+        s = (s.rotate_left(5) ^ u32::from_ne_bytes([w[0], w[1], w[2], w[3]]) as u64).wrapping_mul(0x517c_c1b7_2722_0a95);
+    }
+    for &x in it.remainder() {
+        s = (s.rotate_left(5) ^ x as u64).wrapping_mul(0x517c_c1b7_2722_0a95);
+    }
+    s
+}
+
+fn vis(b: &Bounds<ScaledPixels>, m: &ContentMask<ScaledPixels>, grow: f32) -> [f32; 4] {
+    let x0 = (b.origin.x.0 - grow).max(m.bounds.origin.x.0);
+    let y0 = (b.origin.y.0 - grow).max(m.bounds.origin.y.0);
+    let x1 = (b.origin.x.0 + b.size.width.0 + grow).min(m.bounds.origin.x.0 + m.bounds.size.width.0);
+    let y1 = (b.origin.y.0 + b.size.height.0 + grow).min(m.bounds.origin.y.0 + m.bounds.size.height.0);
+    [x0, y0, x1, y1]
+}
+
+fn tgrow(b: &Bounds<ScaledPixels>, identity: bool) -> f32 {
+    if identity { 0.0 } else { b.size.width.0.max(b.size.height.0) * 0.5 }
+}
+
+impl Digest {
+    pub fn of(scene: &Scene, size: (i32, i32)) -> Self {
+        let mut d = Digest { size, ..Default::default() };
+        d.kinds[0] = scene.quads.iter().map(|q| (h(q), vis(&q.bounds, &q.content_mask, 1.0))).collect();
+        d.kinds[1] = scene.shadows.iter().map(|q| (h(q), vis(&q.bounds, &q.content_mask, q.blur_radius.0 * 3.0 + 2.0))).collect();
+        d.kinds[2] = scene.underlines.iter().map(|q| (h(q), vis(&q.bounds, &q.content_mask, 2.0))).collect();
+        d.kinds[3] = scene
+            .monochrome_sprites
+            .iter()
+            .map(|q| (h(q), vis(&q.bounds, &q.content_mask, 1.0 + tgrow(&q.bounds, q.transformation == gpui::TransformationMatrix::unit()))))
+            .collect();
+        d.kinds[4] = scene
+            .subpixel_sprites
+            .iter()
+            .map(|q| (h(q), vis(&q.bounds, &q.content_mask, 1.0 + tgrow(&q.bounds, q.transformation == gpui::TransformationMatrix::unit()))))
+            .collect();
+        d.kinds[5] = scene.polychrome_sprites.iter().map(|q| (h(q), vis(&q.bounds, &q.content_mask, 1.0))).collect();
+        d.kinds[6] = scene
+            .paths
+            .iter()
+            .map(|p| {
+                (words(format!("{:?}", p).as_bytes()), vis(&p.bounds, &p.content_mask, 2.0))
+            })
+            .collect();
+        d
+    }
+
+    /// The device-pixel rect (x, y, w, h) to redraw, or None for a full redraw.
+    pub fn damage(prev: Option<&Digest>, next: &Digest, scene: &Scene) -> Option<[u32; 4]> {
+        let prev = prev?;
+        if prev.size != next.size || !scene.surfaces.is_empty() {
+            return None;
+        }
+        let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+        let mut add = |r: &[f32; 4]| {
+            if r[2] > r[0] && r[3] > r[1] {
+                x0 = x0.min(r[0]);
+                y0 = y0.min(r[1]);
+                x1 = x1.max(r[2]);
+                y1 = y1.max(r[3]);
+            }
+        };
+        let mut st = String::new();
+        for (k, (a, b)) in prev.kinds.iter().zip(next.kinds.iter()).enumerate() {
+            let n = a.len().max(b.len());
+            let mut nd = 0;
+            for i in 0..n {
+                match (a.get(i), b.get(i)) {
+                    (Some(p), Some(q)) if p.0 == q.0 => {}
+                    (p, q) => {
+                        if crate::perf::ENABLED && nd < 2 { st += &format!(" k{k}[{i}] {:?}->{:?}", p.map(|p| p.1), q.map(|q| q.1)); }
+                        nd += 1;
+                        if let Some(p) = p { add(&p.1) }
+                        if let Some(q) = q { add(&q.1) }
+                    }
+                }
+            }
+            if crate::perf::ENABLED && nd > 0 { st += &format!(" n{k}={nd}/{}", b.len()); }
+        }
+        STATS.with(|c| *c.borrow_mut() = st);
+        let (w, hh) = (next.size.0 as f32, next.size.1 as f32);
+        if x1 <= x0 || y1 <= y0 {
+            // nothing changed: redraw one pixel (the frame is still presented, for frame callbacks)
+            return Some([0, 0, 1, 1]);
+        }
+        let x0 = x0.floor().max(0.0);
+        let y0 = y0.floor().max(0.0);
+        let x1 = x1.ceil().min(w);
+        let y1 = y1.ceil().min(hh);
+        if x1 <= x0 || y1 <= y0 {
+            return Some([0, 0, 1, 1]);
+        }
+        // mostly everything: a plain full redraw (lets the base quad become a clear)
+        if (x1 - x0) * (y1 - y0) > 0.7 * w * hh {
+            return None;
+        }
+        Some([x0 as u32, y0 as u32, (x1 - x0) as u32, (y1 - y0) as u32])
+    }
+}
+
+static STASH: std::sync::Mutex<Option<(u32, u32, Vec<u8>)>> = std::sync::Mutex::new(None);
+/// dev: the hal readback lands here (frame-capture)
+#[allow(dead_code)]
+pub fn stash(w: u32, h: u32, px: Vec<u8>) {
+    *STASH.lock().unwrap() = Some((w, h, px));
+}
+#[allow(dead_code)]
+pub fn take_stash() -> Option<(u32, u32, Vec<u8>)> {
+    STASH.lock().unwrap().take()
+}
