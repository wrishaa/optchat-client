@@ -1945,6 +1959,59 @@ impl Dispatch<super::xdg_compat::keyrouter::tizen_keyrouter::TizenKeyrouter, ()>
 
 /// keys the tizen tv shell keeps unless the app grabs them (remote mic buttons). override with OC_TIZEN_GRAB="a,b".
 #[cfg(feature = "tizen")]
+#[cfg(feature = "tizen")]
+mod tizen_pres {
+    pub use wayland_protocols::wp::presentation_time::client::{wp_presentation, wp_presentation_feedback};
+    pub static N: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    pub static LAST: std::sync::Mutex<(u64, u64, u32, u32, u64, u64)> = std::sync::Mutex::new((0, 0, 0, 0, 0, u64::MAX));
+}
+
+#[cfg(feature = "tizen")]
+impl Dispatch<tizen_pres::wp_presentation::WpPresentation, ()> for WaylandClientStatePtr {
+    fn event(_: &mut Self, _: &tizen_pres::wp_presentation::WpPresentation, event: tizen_pres::wp_presentation::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let tizen_pres::wp_presentation::Event::ClockId { clk_id } = event {
+            log::info!("tizen wp_presentation clock_id={clk_id}");
+        }
+    }
+}
+
+#[cfg(feature = "tizen")]
+impl Dispatch<tizen_pres::wp_presentation_feedback::WpPresentationFeedback, ()> for WaylandClientStatePtr {
+    fn event(_: &mut Self, _: &tizen_pres::wp_presentation_feedback::WpPresentationFeedback, event: tizen_pres::wp_presentation_feedback::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        use tizen_pres::wp_presentation_feedback::Event;
+        // (last_t_ns, last_seq, presented, discarded, sum_interval_ns, min_refresh)
+        let mut l = tizen_pres::LAST.lock().unwrap();
+        match event {
+            Event::Presented { tv_sec_hi, tv_sec_lo, tv_nsec, refresh, seq_hi, seq_lo, flags } => {
+                let t = (((tv_sec_hi as u64) << 32 | tv_sec_lo as u64) * 1_000_000_000) + tv_nsec as u64;
+                let seq = (seq_hi as u64) << 32 | seq_lo as u64;
+                let (dt, dseq) = if l.0 != 0 { (t.saturating_sub(l.0), seq.wrapping_sub(l.1)) } else { (0, 0) };
+                l.2 += 1;
+                let n = l.2;
+                if n <= 40 || n % 120 == 0 {
+                    log::info!("tizen present #{n} refresh_ns={refresh} dt_us={} dseq={dseq} seq={seq} flags={flags:?} discarded={}", dt / 1000, l.3);
+                }
+                l.0 = t;
+                l.1 = seq;
+            }
+            Event::Discarded => {
+                l.3 += 1;
+            }
+            Event::SyncOutput { .. } => {}
+            _ => {}
+        }
+    }
+}
+
+#[cfg(feature = "tizen")]
+pub(crate) fn tizen_request_presentation(globals: &Globals, surface: &wl_surface::WlSurface) {
+    if let Some(p) = globals.presentation.as_ref() {
+        if tizen_pres::N.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 100_000 {
+            p.feedback(surface, &globals.qh, ());
+        }
+    }
+}
+
 fn tizen_grab_keys(state: &WaylandClientState, surface: &wl_surface::WlSurface) {
     static DONE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
     let (Some(kr), Some(ks)) = (state.globals.keyrouter.as_ref(), state.keymap_state.as_ref()) else { return };
