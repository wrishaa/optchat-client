new file mode 100644
index 0000000..54bb019
--- /dev/null
+++ b/crates/gpui_linux/protocols/wl-scaler.xml
@@ -0,0 +1,38 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="scaler">
+  <!-- weston/tizen wl_scaler v2 (the pre-stable form of wp_viewporter); the tizen tv compositor offers wl_scaler@2 -->
+  <interface name="wl_scaler" version="2">
+    <request name="destroy" type="destructor"/>
+    <enum name="error">
+      <entry name="viewport_exists" value="0"/>
+    </enum>
+    <request name="get_viewport">
+      <arg name="id" type="new_id" interface="wl_viewport"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+  </interface>
+  <interface name="wl_viewport" version="2">
+    <request name="destroy" type="destructor"/>
+    <enum name="error">
+      <entry name="bad_value" value="0"/>
+    </enum>
+    <request name="set">
+      <arg name="src_x" type="fixed"/>
+      <arg name="src_y" type="fixed"/>
+      <arg name="src_width" type="fixed"/>
+      <arg name="src_height" type="fixed"/>
+      <arg name="dst_width" type="int"/>
+      <arg name="dst_height" type="int"/>
+    </request>
+    <request name="set_source" since="2">
+      <arg name="x" type="fixed"/>
+      <arg name="y" type="fixed"/>
+      <arg name="width" type="fixed"/>
+      <arg name="height" type="fixed"/>
+    </request>
+    <request name="set_destination" since="2">
+      <arg name="width" type="int"/>
+      <arg name="height" type="int"/>
+    </request>
+  </interface>
+</protocol>
