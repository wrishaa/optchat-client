@@ -2471,7 +2492,21 @@ fn inset_by_tiling(mut bounds: Bounds<Pixels>, inset: Pixels, tiling: Tiling) ->
 /// wp_viewporter nor fractional scale, so the ui lays out at the surface size / scale and draws the full-size buffer
 /// at buffer scale 1 (a 1920×1080 surface at 1.5 is a 1280×720 ui, sharp).
 #[cfg(feature = "tizen")]
-pub(crate) fn tizen_scale() -> f32 {
+pub(crate) fn tizen_ui_scale() -> f32 {
     static S: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
     *S.get_or_init(|| std::env::var("GPUI_TIZEN_SCALE").ok().and_then(|v| v.parse::<f32>().ok()).filter(|v| (1.0..=4.0).contains(v)).unwrap_or(1.0))
 }
+
+/// GPUI_TIZEN_RENDER (0.25..=1): render into a buffer this fraction of the surface and let the compositor scale it
+/// up through tizen's wl_scaler (gpu fill on the tv's Mali-G31 scales with buffer pixels). 1 = native.
+#[cfg(feature = "tizen")]
+pub(crate) fn tizen_render() -> f32 {
+    static S: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
+    *S.get_or_init(|| std::env::var("GPUI_TIZEN_RENDER").ok().and_then(|v| v.parse::<f32>().ok()).filter(|v| (0.25..=1.0).contains(v)).unwrap_or(1.0))
+}
+
+/// the scale gpui draws at: device pixels per logical pixel (ui scale times render scale)
+#[cfg(feature = "tizen")]
+pub(crate) fn tizen_scale() -> f32 {
+    tizen_ui_scale() * tizen_render()
+}
